+def test_retiring_again_while_another_lease_is_outstanding_changes_nothing_for_the_acknowledged_one(world):
+    """Idempotence per call (R3: the between-batches call is evaluated on more turns in worker mode). A second request
+    stays unacknowledged, so every later call really scans: with nothing outstanding retirement returns at once and
+    would hide a lane that is released again. Mutation: a released lane keeps its state (underflow, or a wrong count)."""
+    s, page, host, sim = world
+    first, first_wait = _serve(host, sim, 0, [3])
+    other, other_wait = _serve(host, sim, 1, [4])
+    _release(host, sim, first, first_wait)
+    counters = host.counters()
+    for _ in range(5):
+        host.pump()
+    after = host.counters()
+    assert _leases(host, 0) == [0, 0, 0] and _leases(host, 1)[_slot_of(host, 1, 4)] == 1, "the other lease is untouched"
+    for name in ("leases_acked", "leases_voided", "lease_double_signal", "leases_granted"):
+        assert after[name] == counters[name], name
+    assert counters["leases_acked"] == 1
+
