+@pytest.mark.parametrize("pack_workers", [0, 2])
+def test_an_acknowledgement_delivered_while_a_request_is_in_service_retires_before_that_request_finishes(
+    tmp_path, pack_workers
+):
+    """R3 (LEASE_PROTOCOL 7.5, call site 2). Request 1's lease is acknowledged while request 2 is in service (asleep
+    in the injected delay before its read). Request 2 then reads and stalls before publishing demand_done, and no other
+    retirement can run in that stall: the counter can only have moved from inside the read. Run inline and with two
+    pack workers (the abandon callback is evaluated on more turns there, so the call must be idempotent per batch).
+    Mutation: retirement only at the top of pump_demand (the counter moves only after request 2 is done)."""
+    s = ram_miss_setup(tmp_path, capacity=3)
+    page = new_page(pin=False)
+    host = Exl3RamMissHost(
+        s.tables, page=page, slot_map=torch.full((2, 6), -1, dtype=torch.int32), direct=False, pack_workers=pack_workers
+    )
+    host.enable_lease_mode()
+    host.start_thread(fatal_wait_s=60.0, spin_us=200)
+    sim = LeaseSim(host, page, s.slabs)
+    try:
+        first, first_wait = _served(sim, 0, [3])
+        assert host.counters()["leases_granted"] == 1 and host.counters()["leases_acked"] == 0
+        host.inject(delay_s=0.5)
+        host.inject_done_stall(0.8)
+        second = sim.post(0, [4])  # a miss: it has a read to do
+        assert _until(lambda: host.busy_since_ns() != 0), "precondition: request 2 is in service"
+        assert page_word(page, "demand_done") != second.seq
+        sim.ack(first, first_wait)
+        sim.deliver()
+        assert host.counters()["leases_acked"] == 0, "precondition: the acknowledgement is still unretired"
+        assert _until(lambda: host.counters()["leases_acked"] == 1, timeout_s=10.0)
+        done = page_word(page, "demand_done")  # read AFTER the counter: a mutant's late move cannot pass by racing
+        assert done != second.seq, "the lease was retired only after the request had finished"
+        assert _until(lambda: page_word(page, "demand_done") == second.seq, timeout_s=10.0)
+    finally:
+        host.inject(delay_s=0.0)
+        host.inject_done_stall(0.0)
+        host.stop()
+
+
