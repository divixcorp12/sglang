@@ -19,6 +19,19 @@ int exl3_moe_max_concurrency(int device)
 
 std::set<void*> moe_kernel_attr_set[MAX_DEVICES] = {};
 
+// Experimental: EXL3_MOE_GROUP_WIDTH > 0 caps the widened group size for num_active launches.
+// It can only shrink the grid, so the co-residency bound still holds. 0 / unset = automatic.
+static int moe_group_width_override()
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        const char* e = getenv("EXL3_MOE_GROUP_WIDTH");
+        v = e ? atoi(e) : 0;
+    }
+    return v;
+}
+
 // EXL3_MOE_TILE_N=128 keeps the N = 128 tile shape for dims that are multiples of 256 (which
 // otherwise take the N = 256 instances); 0 / unset = automatic
 static int moe_tile_n_override()
@@ -272,6 +285,7 @@ void exl3_moe
     {
         num_groups = MIN(num_groups, num_active);
         group_size = MIN(num_sms / num_groups, MOE_MAX_SMS_PER_EXPERT);
+        if (moe_group_width_override() > 0) group_size = MAX(1, MIN(group_size, moe_group_width_override()));
     }
     dim3 grid_dim(group_size, 1, num_groups);
 
